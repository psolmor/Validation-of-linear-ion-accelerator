OPTION, PSDUMPFREQ=10000;
OPTION, STATDUMPFREQ= 1;
OPTION, TELL=TRUE;
OPTION, ASCIIDUMP=TRUE;
OPTION, ENABLEHDF5=FALSE;
Option, VERSION=10900;


TITLE, STRING="opal-t: simulation of LEBT";

REAL Edes  = 0.000182629;          
REAL CHARGEo = 6.0;         
REAL gamma = 1 + Edes/CMASS;
REAL beta  = sqrt(1 - (1 / (gamma^2)));
REAL gambet = gamma * beta;
REAL P0 = gambet * CMASS;  
REAL rf   = 749.48;        
REAL Qtot = 2.89e-06;     
REAL PIHALF = PI/2;
REAL E_ang = 27*degrad;

VALUE, VALUE={gamma, beta, gambet, P0,PIHALF};

DRIFT_TEST:    DRIFT,       L=1,  ELEMEDGE=0.000;
DRIFT3:    DRIFT,       L=0.208,  ELEMEDGE=0.000;
DRIFTCHOP: DRIFT,       L=0.150,  ELEMEDGE=0.208;
DRIFT4:    DRIFT,       L=0.140,  ELEMEDGE=0.358;
DRIFT5:    DRIFT,       L=0.722,  ELEMEDGE=0.498;

MONITOR_PRECOLLX: MONITOR, OUTFN="MONITOR_TEST1",ELEMEDGE=1.220, L=0.001;
MONITOR_POSTCOLLX: MONITOR, OUTFN="MONITOR_TEST2",ELEMEDGE=1.222,L=0.001;

COLLX:     ECOLLIMATOR, L=0.002, XSIZE=0.0118, YSIZE=0.0400, ELEMEDGE=1.220;
COLLX_DRIFT: DRIFT, L=0.002, APERTURE="ELLIPSE(0.0236,1,1)", ELEMEDGE=1.220;
MONITOR_COLLX: MONITOR, OUTFN="MONITOR_COLLX.txt",ELEMEDGE=1.222;
DRIFTCOL:  DRIFT,       L=0.002, ELEMEDGE=1.222;
COLLY:     ECOLLIMATOR, L=0.002, XSIZE=0.0400, YSIZE=0.0200, ELEMEDGE=1.224;
COLLY_DRIFT: DRIFT, L=0.002, APERTURE="ELLIPSE(1,0.04,1)", ELEMEDGE=1.224;

DRIFT6:    DRIFT,       L=0.194,  ELEMEDGE=1.226;

QUAD1:     QUADRUPOLE,  L=0.140, K1=-1.19, ELEMEDGE=1.420;
DRIFT7:    DRIFT,       L=0.092,           ELEMEDGE=1.560;
QUAD2:     QUADRUPOLE,  L=0.140, K1= 1.76, ELEMEDGE=1.652;
DRIFT8:    DRIFT,       L=0.092,           ELEMEDGE=1.792;
QUAD3:     QUADRUPOLE,  L=0.140, K1=-2.13, ELEMEDGE=1.884;

DRIFT9:    DRIFT,       L=0.9101, ELEMEDGE=2.024;

SOL1:      SOLENOID,
           L=0.2574,
           KS=0.344,
           FMAPFN="solenoid_1D.map",
           ELEMEDGE=2.9341;

DRIFT10:   DRIFT,       L=0.139,  ELEMEDGE=3.1915;

LEBT: LINE=(
        DRIFT3,DRIFTCHOP,DRIFT4,DRIFT5,COLLX_DRIFT,MONITOR_PRECOLLX,MONITOR_POSTCOLLX,DRIFTCOL,COLLY_DRIFT
        );



DISTRIB2: DISTRIBUTION,
          TYPE=FROMFILE,
          WRITETOFILE=TRUE,
          FNAME="opal_beam.txt";


FS1:FIELDSOLVER, FSTYPE=NONE, MX=64, MY=64, MT=64, PARFFTX=true, PARFFTY=true, PARFFTT=true,
		 BCFFTX=open, BCFFTY=open, BCFFTT=open, BBOXINCR=1, GREENSF=STANDARD;


BEAM_4: BEAM,
        PARTICLE=CARBON,
        MASS=CMASS,
        CHARGE=CHARGEo,
        PC=P0,
        NPART= 15673,
        BCURRENT=Qtot,
        BFREQ=rf,
        MOMENTUMTOLERANCE=0;

REAL DT = 2.0e-11;
REAL VELOCITY= beta*CLIGHT;
REAL STEP = DT * VELOCITY;
REAL NSTEP = 200000;

VALUE, VALUE={STEP};

SELECT, LINE=LEBT;

TRACK, LINE=LEBT,
       BEAM=BEAM_4,
       MAXSTEPS=NSTEP,
       DT=DT,
       ZSTART=0.0,
       ZSTOP = 1.5 ;

RUN, METHOD="PARALLEL-T",
     BEAM=BEAM_4,
     FIELDSOLVER=FS1,
     DISTRIBUTION=DISTRIB2;

ENDTRACK;
STOP;