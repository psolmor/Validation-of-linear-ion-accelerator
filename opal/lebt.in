OPTION, PSDUMPFREQ=10000;
OPTION, STATDUMPFREQ= 1;
OPTION, TELL=TRUE;
OPTION, ASCIIDUMP=TRUE;
OPTION, ENABLEHDF5=FALSE;
Option, VERSION=10900;

TITLE, STRING="opal-t: simulation of LEBT";

REAL Edes  = 0.000182629;          
REAL CHARGEo = 6.0;         
REAL gamma = 1 + Edes/CMASS;
REAL beta  = sqrt(1 - (1 / (gamma^2)));
REAL gambet = gamma * beta;
REAL P0 = gambet * CMASS;  
REAL rf   = 749.48;        
REAL Qtot = 2.89e-06;     
REAL PIHALF = PI/2;
REAL E_ang = 27*degrad;

VALUE, VALUE={gamma, beta, gambet, P0,PIHALF};

QUAD1:     QUADRUPOLE, L=0.140, K1=-1.19, ELEMEDGE=0.000;
DRIFT7:    DRIFT,      L=0.092,           ELEMEDGE=0.140;
QUAD2:     QUADRUPOLE, L=0.140, K1= 1.76, ELEMEDGE=0.232;
DRIFT8:    DRIFT,      L=0.092,           ELEMEDGE=0.372;
QUAD3:     QUADRUPOLE, L=0.140, K1=-2.13, ELEMEDGE=0.464;

DRIFT9:    DRIFT,       L=0.9101, ELEMEDGE=1.226;

SOL1:      SOLENOID,
           L=0.2574,
           KS=0.344,
           FMAPFN="solenoid_1D.map",
           ELEMEDGE=2.9341;

DRIFT10:   DRIFT,       L=0.139,  ELEMEDGE=3.1915;


LEBT: LINE=(
        QUAD1,DRIFT7,QUAD2,DRIFT8,QUAD3
        );

DISTRIB2: DISTRIBUTION,
          TYPE=FROMFILE,
          FNAME="opal_beam.txt";


FS1:FIELDSOLVER, FSTYPE=NONE, MX=64, MY=64, MT=64, PARFFTX=true, PARFFTY=true, PARFFTT=true,
		 BCFFTX=open, BCFFTY=open, BCFFTT=open, BBOXINCR=1, GREENSF=STANDARD;


BEAM_4: BEAM,
        PARTICLE=CARBON,
        MASS=CMASS,
        CHARGE=CHARGEo,
        PC=P0,
        NPART= 14875,
        BCURRENT=Qtot,
        BFREQ=rf,
        MOMENTUMTOLERANCE=0;

REAL DT = 2.0e-11;
REAL NSTEP = 200000;

SELECT, LINE=LEBT;

TRACK, LINE=LEBT,
       BEAM=BEAM_4,
       MAXSTEPS=NSTEP,
       DT=DT,
       ZSTART=0.0,
       ZSTOP = 0.604 ;

RUN, METHOD="PARALLEL-T",
     BEAM=BEAM_4,
     FIELDSOLVER=FS1,
     DISTRIBUTION=DISTRIB2;

ENDTRACK;
STOP;